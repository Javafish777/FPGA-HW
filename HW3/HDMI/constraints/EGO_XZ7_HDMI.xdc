## EGO-XZ7 hardware manual V1.2 - HDMI / ADV7511
## FPGA: XC7Z020-CLG484-1
## Pixel clock generated by MMCME2_BASE: 100 MHz * 81 / 322 = 25.1553 MHz.
##
## HDMI signal pins are Bank 33 and use LVCMOS33 on this board revision.
## BTNC (P16) is Bank 34; JP1 VADJ default is 2.5 V, so it uses LVCMOS25.
## If JP1 is changed to 3.3 V, change BTNC to LVCMOS33 as well.

## 100 MHz PL clock
set_property -dict { PACKAGE_PIN Y9 IOSTANDARD LVCMOS33 } [get_ports CLK_100M]
create_clock -name clk100 -period 10.000 [get_ports CLK_100M]

## Centre push-button - active-high reset, Bank 34 / default VADJ 2.5 V
set_property -dict { PACKAGE_PIN P16 IOSTANDARD LVCMOS25 } [get_ports BTNC]

## HDMI transmitter parallel data bus.
## HDL HDMI_D[n] is ADV7511 D[n]; EGO manual names the FPGA nets HDMI_D16..D23
## for ADV7511 D0..D7, then HDMI_D0..D15 for ADV7511 D8..D23.
set_property -dict { PACKAGE_PIN AA21 IOSTANDARD LVCMOS33 } [get_ports {HDMI_D[0]}]
set_property -dict { PACKAGE_PIN AB21 IOSTANDARD LVCMOS33 } [get_ports {HDMI_D[1]}]
set_property -dict { PACKAGE_PIN Y20  IOSTANDARD LVCMOS33 } [get_ports {HDMI_D[2]}]
set_property -dict { PACKAGE_PIN Y21  IOSTANDARD LVCMOS33 } [get_ports {HDMI_D[3]}]
set_property -dict { PACKAGE_PIN AB19 IOSTANDARD LVCMOS33 } [get_ports {HDMI_D[4]}]
set_property -dict { PACKAGE_PIN AB20 IOSTANDARD LVCMOS33 } [get_ports {HDMI_D[5]}]
set_property -dict { PACKAGE_PIN Y19  IOSTANDARD LVCMOS33 } [get_ports {HDMI_D[6]}]
set_property -dict { PACKAGE_PIN AA19 IOSTANDARD LVCMOS33 } [get_ports {HDMI_D[7]}]

set_property -dict { PACKAGE_PIN Y13  IOSTANDARD LVCMOS33 } [get_ports {HDMI_D[8]}]
set_property -dict { PACKAGE_PIN AA13 IOSTANDARD LVCMOS33 } [get_ports {HDMI_D[9]}]
set_property -dict { PACKAGE_PIN AA14 IOSTANDARD LVCMOS33 } [get_ports {HDMI_D[10]}]
set_property -dict { PACKAGE_PIN Y14  IOSTANDARD LVCMOS33 } [get_ports {HDMI_D[11]}]
set_property -dict { PACKAGE_PIN AB15 IOSTANDARD LVCMOS33 } [get_ports {HDMI_D[12]}]
set_property -dict { PACKAGE_PIN AB16 IOSTANDARD LVCMOS33 } [get_ports {HDMI_D[13]}]
set_property -dict { PACKAGE_PIN AA16 IOSTANDARD LVCMOS33 } [get_ports {HDMI_D[14]}]
set_property -dict { PACKAGE_PIN AB17 IOSTANDARD LVCMOS33 } [get_ports {HDMI_D[15]}]

set_property -dict { PACKAGE_PIN AA17 IOSTANDARD LVCMOS33 } [get_ports {HDMI_D[16]}]
set_property -dict { PACKAGE_PIN Y15  IOSTANDARD LVCMOS33 } [get_ports {HDMI_D[17]}]
set_property -dict { PACKAGE_PIN W13  IOSTANDARD LVCMOS33 } [get_ports {HDMI_D[18]}]
set_property -dict { PACKAGE_PIN W15  IOSTANDARD LVCMOS33 } [get_ports {HDMI_D[19]}]
set_property -dict { PACKAGE_PIN V15  IOSTANDARD LVCMOS33 } [get_ports {HDMI_D[20]}]
set_property -dict { PACKAGE_PIN U17  IOSTANDARD LVCMOS33 } [get_ports {HDMI_D[21]}]
set_property -dict { PACKAGE_PIN V14  IOSTANDARD LVCMOS33 } [get_ports {HDMI_D[22]}]
set_property -dict { PACKAGE_PIN V13  IOSTANDARD LVCMOS33 } [get_ports {HDMI_D[23]}]

## HDMI separate sync and pixel clock
set_property -dict { PACKAGE_PIN V17 IOSTANDARD LVCMOS33 } [get_ports HDMI_HSYNC]
set_property -dict { PACKAGE_PIN W17 IOSTANDARD LVCMOS33 } [get_ports HDMI_VSYNC]
set_property -dict { PACKAGE_PIN W18 IOSTANDARD LVCMOS33 } [get_ports HDMI_CLK]

## HDMI I2C control bus - open-drain in the VHDL.
set_property -dict { PACKAGE_PIN AA18 IOSTANDARD LVCMOS33 } [get_ports HDMI_SCL]
set_property -dict { PACKAGE_PIN Y16  IOSTANDARD LVCMOS33 } [get_ports HDMI_SDA]
set_property -dict { PACKAGE_PIN W16  IOSTANDARD LVCMOS33 } [get_ports HDMI_INT]

## User LEDs: LED0 = ADV7511 init complete, LED1 = I2C/init error
set_property -dict { PACKAGE_PIN T22 IOSTANDARD LVCMOS33 } [get_ports LED0]
set_property -dict { PACKAGE_PIN T21 IOSTANDARD LVCMOS33 } [get_ports LED1]

## Pixel clock exported from MMCM.
create_generated_clock -name hdmi_pixel_clk \
    -source [get_ports CLK_100M] -multiply_by 81 -divide_by 322 \
    [get_ports HDMI_CLK]
